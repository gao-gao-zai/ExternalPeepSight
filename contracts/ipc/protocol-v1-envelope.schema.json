{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExternalPeepSight IPC envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "requestId",
    "type",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "Hello",
        "GetState",
        "ApplySnapshot",
        "SetActiveProfile",
        "SetSwitchState",
        "SetMonitorSelection",
        "ShowToast",
        "Ack",
        "Error",
        "HostStateChanged"
      ]
    },
    "payload": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
