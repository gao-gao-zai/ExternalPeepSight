<UserControl
    x:Class="ExternalPeepSight.UI.Views.ImageEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ExternalPeepSight.Core"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:ExternalPeepSight.UI.ViewModels"
    x:DataType="vm:ImageEditorViewModel">
    <Grid Margin="24" RowDefinitions="Auto,16,*">
        <TextBlock Classes="page-title" Text="{DynamicResource Loc.Navigation.Image}" />
        <Grid Grid.Row="2" ColumnDefinitions="*,20,420">
            <Border Classes="surface" Padding="12">
                <Grid RowDefinitions="Auto,10,*,10,Auto">
                    <TextBlock Classes="section-title" Text="{DynamicResource Loc.Crosshair.Preview}" />
                    <Border
                        Grid.Row="2"
                        Background="{DynamicResource AppPreviewBrush}"
                        CornerRadius="4">
                        <Grid>
                            <Image
                                Margin="20"
                                IsVisible="{Binding HasRasterPreview}"
                                Source="{Binding PreviewBitmap}"
                                Stretch="Uniform" />
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !HasRasterPreview}"
                                Spacing="10">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="42"
                                    Foreground="#D9E0E5"
                                    Text="&#xEB9F;" />
                                <TextBlock
                                    MaxWidth="300"
                                    Foreground="#D9E0E5"
                                    Text="{Binding AssetDetails}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    MaxWidth="300"
                                    Foreground="#98A4AD"
                                    IsVisible="{Binding HasAsset}"
                                    Text="{DynamicResource Loc.Image.PreviewUnavailable}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock
                        Grid.Row="4"
                        Classes="secondary"
                        Text="{Binding AssetDetails}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="surface" Padding="20">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Classes="inspector-section">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section-title" Text="{DynamicResource Loc.Common.Mode}" />
                                <Grid ColumnDefinitions="*,8,*">
                                    <RadioButton
                                        Classes="segment"
                                        Content="{DynamicResource Loc.Common.Crosshair}"
                                        GroupName="ImageMode"
                                        IsChecked="{Binding IsCrosshairMode, Mode=TwoWay}" />
                                    <RadioButton
                                        Grid.Column="2"
                                        Classes="segment"
                                        Content="{DynamicResource Loc.Common.Image}"
                                        GroupName="ImageMode"
                                        IsEnabled="{Binding CanActivateImage}"
                                        IsChecked="{Binding IsImageMode, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Classes="inspector-section">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section-title" Text="{DynamicResource Loc.Image.Asset}" />
                                <Grid ColumnDefinitions="*,8,34">
                                    <ComboBox
                                        ItemsSource="{Binding Assets}"
                                        SelectedItem="{Binding SelectedAsset, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="core:AssetReference">
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button
                                        Grid.Column="2"
                                        Classes="icon"
                                        Command="{Binding ImportImageCommand}"
                                        Content="&#xE8B7;"
                                        ToolTip.Tip="{DynamicResource Loc.Image.ImportAsset}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Classes="inspector-section last">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section-title" Text="{DynamicResource Loc.Common.Position}" />
                                <Grid ColumnDefinitions="128,*">
                                    <TextBlock Classes="field-label" Text="{DynamicResource Loc.Common.Anchor}" />
                                    <Grid Grid.Column="1" ColumnDefinitions="*,8,*">
                                        <RadioButton
                                            Classes="segment"
                                            Content="{DynamicResource Loc.Common.ScreenCenter}"
                                            GroupName="ImageAnchor"
                                            IsChecked="{Binding IsScreenCenterAnchor, Mode=TwoWay}" />
                                        <RadioButton
                                            Grid.Column="2"
                                            Classes="segment"
                                            Content="{DynamicResource Loc.Common.TopLeft}"
                                            GroupName="ImageAnchor"
                                            IsChecked="{Binding IsTopLeftAnchor, Mode=TwoWay}" />
                                    </Grid>
                                </Grid>
                                <Grid ColumnDefinitions="128,*,10,96">
                                    <TextBlock Classes="field-label" Text="{DynamicResource Loc.Common.OffsetX}" />
                                    <Slider
                                        Grid.Column="1"
                                        Classes="inspector-slider"
                                        Minimum="-1000"
                                        Maximum="1000"
                                        Value="{Binding OffsetX, Mode=TwoWay}" />
                                    <fa:FANumberBox
                                        Grid.Column="3"
                                        Minimum="-100000"
                                        Maximum="100000"
                                        Value="{Binding OffsetX, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="128,*,10,96">
                                    <TextBlock Classes="field-label" Text="{DynamicResource Loc.Common.OffsetY}" />
                                    <Slider
                                        Grid.Column="1"
                                        Classes="inspector-slider"
                                        Minimum="-1000"
                                        Maximum="1000"
                                        Value="{Binding OffsetY, Mode=TwoWay}" />
                                    <fa:FANumberBox
                                        Grid.Column="3"
                                        Minimum="-100000"
                                        Maximum="100000"
                                        Value="{Binding OffsetY, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="128,*,10,96">
                                    <TextBlock Classes="field-label" Text="{DynamicResource Loc.Image.Scale}" />
                                    <Slider
                                        Grid.Column="1"
                                        Classes="inspector-slider"
                                        Minimum="0.01"
                                        Maximum="5"
                                        Value="{Binding Scale, Mode=TwoWay}" />
                                    <fa:FANumberBox
                                        Grid.Column="3"
                                        Minimum="0.01"
                                        Maximum="100"
                                        SmallChange="0.05"
                                        Value="{Binding Scale, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="128,*">
                                    <TextBlock Classes="field-label" Text="{DynamicResource Loc.Image.KeepAspect}" />
                                    <CheckBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        IsChecked="{Binding KeepAspectRatio, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
